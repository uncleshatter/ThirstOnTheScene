<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thirst Responders — Quench The Alarm</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --night: #060C0A;
  --ink: #0D1710;
  --slate: #152219;
  --dim: #1C2E23;
  --mid: #2D4A38;
  --white: #F0FBF6;
  --white-soft: rgba(240,251,246,0.72);
  --white-muted: rgba(240,251,246,0.38);
  --white-ghost: rgba(240,251,246,0.12);
  --cyan: #00E5CC;
  --cyan-dk: #009688;
  --cyan-glow: rgba(0,229,204,0.18);
  --ember: #FF4D2E;
  --ember-glow: rgba(255,77,46,0.2);
  --volt: #CCFF00;
  --volt-glow: rgba(204,255,0,0.15);
  --gold: #F4C430;
  --red: #CC2929;
  --navy: #0D1B2A;
  --font-display: 'Bebas Neue', sans-serif;
  --font-body: 'Sora', sans-serif;
  --font-mono: 'Space Mono', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--night);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  overflow-x: hidden;
}

/* ─── GRAIN OVERLAY ─── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0.028;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: var(--night); }
::-webkit-scrollbar-thumb { background: var(--cyan-dk); border-radius: 2px; }

/* ─── SELECTION ─── */
::selection { background: var(--cyan); color: var(--night); }

/* ─── NAV ─── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 48px;
  background: rgba(6,12,10,0.7);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(0,229,204,0.08);
  transition: all 0.3s ease;
}
nav.scrolled {
  padding: 12px 48px;
  border-bottom-color: rgba(0,229,204,0.16);
}
.nav-logo {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.12em;
  color: var(--white);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 10px;
}
.nav-logo .dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--cyan);
  animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot {
  0%,100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}
.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
}
.nav-links a {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--white-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--cyan); }
.nav-cta {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--night);
  background: var(--cyan);
  border: none;
  padding: 9px 22px;
  border-radius: 3px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
}
.nav-cta:hover {
  background: var(--volt);
  box-shadow: 0 0 24px var(--volt-glow);
}

/* ─── HERO ─── */
#hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--ink);
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,229,204,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,229,204,0.04) 1px, transparent 1px);
  background-size: 52px 52px;
  animation: grid-drift 30s linear infinite;
}
@keyframes grid-drift {
  0% { background-position: 0 0; }
  100% { background-position: 52px 52px; }
}
.hero-glow-1 {
  position: absolute;
  width: 900px; height: 700px;
  top: -20%; right: -10%;
  background: radial-gradient(ellipse, rgba(0,150,136,0.18) 0%, transparent 70%);
  animation: glow-breathe 8s ease-in-out infinite alternate;
}
.hero-glow-2 {
  position: absolute;
  width: 600px; height: 500px;
  bottom: -10%; left: -5%;
  background: radial-gradient(ellipse, rgba(0,229,204,0.08) 0%, transparent 65%);
}
@keyframes glow-breathe {
  0% { opacity: 0.6; transform: scale(1); }
  100% { opacity: 1; transform: scale(1.08); }
}
.hero-scan {
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  animation: scan-line 6s linear infinite;
  opacity: 0.35;
}
@keyframes scan-line {
  0% { top: -5%; }
  100% { top: 105%; }
}
.hero-content {
  position: relative;
  z-index: 2;
  padding: 140px 80px 80px;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}
.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.hero-eyebrow::before {
  content: '';
  display: inline-block;
  width: 24px; height: 1px;
  background: var(--cyan);
}
.hero-dispatch {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--ember);
  margin-bottom: 6px;
  animation: blink-text 1.4s step-end infinite;
}
@keyframes blink-text {
  0%,100% { opacity: 1; }
  50% { opacity: 0.3; }
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(80px, 14vw, 180px);
  line-height: 0.88;
  letter-spacing: 0.01em;
  color: var(--white);
  position: relative;
  margin-bottom: 8px;
}
.hero-title .line-cyan {
  display: block;
  background: linear-gradient(135deg, #F0FBF6 20%, #00E5CC 85%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-title .line-ember {
  display: block;
  background: linear-gradient(135deg, #FF4D2E 10%, #F4C430 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-tagline {
  font-family: var(--font-display);
  font-size: clamp(22px, 4vw, 52px);
  letter-spacing: 0.18em;
  color: var(--cyan);
  margin-bottom: 32px;
  opacity: 0.9;
}
.hero-sub {
  font-size: 16px;
  color: var(--white-soft);
  max-width: 520px;
  line-height: 1.75;
  margin-bottom: 44px;
  font-weight: 300;
}
.hero-actions {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 64px;
}
.btn-primary {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--night);
  background: var(--cyan);
  border: none;
  padding: 16px 36px;
  border-radius: 3px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
}
.btn-primary::after {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--volt);
  transform: translateX(-101%);
  transition: transform 0.3s ease;
}
.btn-primary:hover::after { transform: translateX(0); }
.btn-primary span { position: relative; z-index: 1; }
.btn-ghost {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cyan);
  background: transparent;
  border: 1px solid rgba(0,229,204,0.35);
  padding: 15px 34px;
  border-radius: 3px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.25s;
}
.btn-ghost:hover {
  background: rgba(0,229,204,0.08);
  border-color: var(--cyan);
  box-shadow: 0 0 24px rgba(0,229,204,0.12);
}
.hero-stats {
  display: flex;
  gap: 48px;
  flex-wrap: wrap;
}
.hero-stat-item {
  display: flex;
  flex-direction: column;
}
.hero-stat-n {
  font-family: var(--font-display);
  font-size: 36px;
  color: var(--cyan);
  line-height: 1;
}
.hero-stat-l {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--white-muted);
  margin-top: 4px;
  text-transform: uppercase;
}
.hero-badge {
  position: absolute;
  bottom: 48px;
  right: 80px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.hero-badge-chip {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 20px;
  display: inline-block;
}
.chip-cyan {
  background: rgba(0,229,204,0.1);
  border: 1px solid rgba(0,229,204,0.25);
  color: var(--cyan);
}
.chip-ember {
  background: rgba(255,77,46,0.1);
  border: 1px solid rgba(255,77,46,0.25);
  color: var(--ember);
}
.chip-volt {
  background: rgba(204,255,0,0.08);
  border: 1px solid rgba(204,255,0,0.22);
  color: var(--volt);
}

/* ─── MARQUEE ─── */
.marquee-section {
  background: var(--night);
  border-top: 1px solid rgba(0,229,204,0.08);
  border-bottom: 1px solid rgba(0,229,204,0.08);
  padding: 16px 0;
  overflow: hidden;
  position: relative;
}
.marquee-section::before,
.marquee-section::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0;
  width: 120px;
  z-index: 2;
}
.marquee-section::before { left: 0; background: linear-gradient(90deg, var(--night), transparent); }
.marquee-section::after { right: 0; background: linear-gradient(-90deg, var(--night), transparent); }
.marquee-track {
  display: flex;
  animation: marquee-scroll 24s linear infinite;
  width: max-content;
  gap: 0;
}
@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.marquee-item {
  font-family: var(--font-display);
  font-size: 13px;
  letter-spacing: 0.3em;
  color: var(--white-muted);
  padding: 0 28px;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 20px;
}
.marquee-item .sep {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--cyan);
  flex-shrink: 0;
}
.marquee-item.highlight { color: var(--cyan); }

/* ─── SECTION BASE ─── */
section {
  position: relative;
  overflow: hidden;
}
.section-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 80px;
}
.eyebrow {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.eyebrow::before {
  content: '';
  width: 18px; height: 1px;
  background: var(--cyan);
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(42px, 6vw, 80px);
  line-height: 0.9;
  letter-spacing: 0.01em;
  color: var(--white);
  margin-bottom: 20px;
}
.section-title .accent { color: var(--cyan); }
.section-title .ember { color: var(--ember); }
.body-text {
  font-size: 15px;
  font-weight: 300;
  color: var(--white-soft);
  line-height: 1.8;
}
.rule { width: 36px; height: 2px; background: var(--cyan); border-radius: 1px; margin: 18px 0; }
.rule-full { width: 100%; height: 1px; background: rgba(0,229,204,0.1); margin: 24px 0; }

/* ─── MISSION ─── */
#mission {
  padding: 140px 0;
  background: var(--night);
}
.mission-bg-glow {
  position: absolute;
  width: 700px; height: 600px;
  top: 50%; left: -100px;
  transform: translateY(-50%);
  background: radial-gradient(ellipse, rgba(0,229,204,0.06) 0%, transparent 65%);
  pointer-events: none;
}
.mission-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.mission-quote {
  border-left: 2px solid var(--cyan);
  padding: 20px 28px;
  background: rgba(0,229,204,0.04);
  border-radius: 0 8px 8px 0;
  margin-top: 28px;
}
.mission-quote p {
  font-size: 17px;
  font-style: italic;
  color: var(--white-soft);
  line-height: 1.7;
}
.mission-quote cite {
  display: block;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--white-muted);
  margin-top: 10px;
  font-style: normal;
}
.mission-pillars {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.pillar {
  display: flex;
  gap: 20px;
  padding: 22px 24px;
  border: 1px solid transparent;
  border-radius: 8px;
  transition: all 0.3s ease;
  cursor: default;
}
.pillar:hover {
  background: rgba(0,229,204,0.04);
  border-color: rgba(0,229,204,0.14);
}
.pillar-icon {
  font-family: var(--font-display);
  font-size: 32px;
  color: var(--cyan);
  line-height: 1;
  flex-shrink: 0;
  width: 48px;
  text-align: center;
}
.pillar-body h3 {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.05em;
  color: var(--white);
  margin-bottom: 4px;
}
.pillar-body p {
  font-size: 13px;
  color: var(--white-muted);
  line-height: 1.65;
}

/* ─── STATS BAND ─── */
#stats {
  padding: 0;
  background: var(--slate);
  border-top: 1px solid rgba(0,229,204,0.1);
  border-bottom: 1px solid rgba(0,229,204,0.1);
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.stat-block {
  padding: 52px 40px;
  border-right: 1px solid rgba(0,229,204,0.08);
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: background 0.3s;
}
.stat-block:last-child { border-right: none; }
.stat-block:hover { background: rgba(0,229,204,0.04); }
.stat-number {
  font-family: var(--font-display);
  font-size: clamp(44px, 5vw, 68px);
  line-height: 1;
  color: var(--cyan);
  margin-bottom: 8px;
  display: block;
}
.stat-number.gold { color: var(--gold); }
.stat-number.ember { color: var(--ember); }
.stat-label {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--white-muted);
  line-height: 1.6;
}
.stat-source {
  font-family: var(--font-mono);
  font-size: 8px;
  color: rgba(0,229,204,0.3);
  margin-top: 6px;
  letter-spacing: 0.08em;
}

/* ─── WHAT WE DEPLOY ─── */
#deploy {
  padding: 140px 0;
  background: var(--ink);
}
.deploy-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,229,204,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,229,204,0.025) 1px, transparent 1px);
  background-size: 44px 44px;
}
.deploy-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 72px;
}
.deploy-header .eyebrow { justify-content: center; }
.deploy-header .eyebrow::before { display: none; }
.deploy-header .rule { margin: 18px auto; }
.deploy-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.deploy-card {
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.1);
  border-radius: 12px;
  padding: 32px 28px;
  position: relative;
  overflow: hidden;
  transition: all 0.35s ease;
  cursor: default;
}
.deploy-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  opacity: 0;
  transition: opacity 0.35s;
}
.deploy-card:hover {
  border-color: rgba(0,229,204,0.3);
  background: rgba(0,229,204,0.06);
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(0,0,0,0.4), 0 0 36px rgba(0,229,204,0.08);
}
.deploy-card:hover::before { opacity: 1; }
.deploy-card:nth-child(2) { border-color: rgba(255,77,46,0.12); }
.deploy-card:nth-child(2):hover {
  border-color: rgba(255,77,46,0.35);
  background: rgba(255,77,46,0.06);
  box-shadow: 0 20px 48px rgba(0,0,0,0.4), 0 0 36px rgba(255,77,46,0.08);
}
.deploy-card:nth-child(2)::before {
  background: linear-gradient(90deg, transparent, var(--ember), transparent);
}
.deploy-card:nth-child(3) { border-color: rgba(204,255,0,0.1); }
.deploy-card:nth-child(3):hover {
  border-color: rgba(204,255,0,0.28);
  background: rgba(204,255,0,0.04);
  box-shadow: 0 20px 48px rgba(0,0,0,0.4), 0 0 36px rgba(204,255,0,0.06);
}
.deploy-card:nth-child(3)::before {
  background: linear-gradient(90deg, transparent, var(--volt), transparent);
}
.deploy-card:nth-child(4) { border-color: rgba(244,196,48,0.1); }
.deploy-card:nth-child(4):hover {
  border-color: rgba(244,196,48,0.3);
  background: rgba(244,196,48,0.04);
  box-shadow: 0 20px 48px rgba(0,0,0,0.4), 0 0 36px rgba(244,196,48,0.07);
}
.deploy-card:nth-child(4)::before {
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}
.card-icon {
  font-size: 36px;
  margin-bottom: 18px;
  display: block;
  line-height: 1;
}
.card-label {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 8px;
}
.deploy-card:nth-child(2) .card-label { color: var(--ember); }
.deploy-card:nth-child(3) .card-label { color: var(--volt); }
.deploy-card:nth-child(4) .card-label { color: var(--gold); }
.card-title {
  font-family: var(--font-display);
  font-size: 28px;
  letter-spacing: 0.03em;
  color: var(--white);
  margin-bottom: 12px;
}
.card-body {
  font-size: 13px;
  color: var(--white-muted);
  line-height: 1.7;
}

/* ─── OPERATIONAL PIPELINE ─── */
#ops {
  padding: 140px 0;
  background: var(--night);
}
.ops-header { margin-bottom: 64px; }
.pipeline {
  display: flex;
  align-items: flex-start;
  gap: 0;
  position: relative;
}
.pipeline::before {
  content: '';
  position: absolute;
  top: 40px;
  left: 40px;
  right: 40px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0,229,204,0.25) 15%, rgba(0,229,204,0.25) 85%, transparent);
}
.pipeline-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 16px;
  position: relative;
}
.step-num {
  width: 80px; height: 80px;
  border-radius: 50%;
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 28px;
  color: var(--cyan);
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
  transition: all 0.3s;
}
.pipeline-step:hover .step-num {
  background: rgba(0,229,204,0.1);
  border-color: var(--cyan);
  box-shadow: 0 0 28px rgba(0,229,204,0.18);
}
.step-title {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--white);
  margin-bottom: 8px;
}
.step-desc {
  font-size: 12px;
  color: var(--white-muted);
  line-height: 1.65;
}
.ops-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-top: 64px;
}
.metric-card {
  background: var(--slate);
  border: 1px solid rgba(0,229,204,0.1);
  border-radius: 8px;
  padding: 22px 20px;
  text-align: center;
}
.metric-n {
  font-family: var(--font-display);
  font-size: 32px;
  color: var(--cyan);
  margin-bottom: 4px;
}
.metric-l {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  color: var(--white-muted);
  text-transform: uppercase;
  line-height: 1.5;
}

/* ─── MARKET BAND ─── */
#market {
  padding: 100px 0;
  background: linear-gradient(180deg, var(--ink) 0%, var(--slate) 100%);
  border-top: 1px solid rgba(0,229,204,0.08);
}
.market-inner {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 80px;
  align-items: center;
}
.market-big {
  font-family: var(--font-display);
  font-size: clamp(60px, 9vw, 120px);
  line-height: 0.85;
  color: var(--white);
}
.market-big .ln { display: block; }
.market-big .zero { color: var(--cyan); }
.market-stat-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 28px;
}
.market-stat-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 18px;
  background: rgba(0,229,204,0.04);
  border: 1px solid rgba(0,229,204,0.08);
  border-radius: 6px;
  transition: all 0.25s;
}
.market-stat-row:hover {
  border-color: rgba(0,229,204,0.2);
  background: rgba(0,229,204,0.07);
}
.market-val {
  font-family: var(--font-display);
  font-size: 28px;
  color: var(--cyan);
  min-width: 90px;
}
.market-val.gold { color: var(--gold); }
.market-desc {
  font-size: 13px;
  color: var(--white-soft);
  line-height: 1.55;
  flex: 1;
}
.market-src {
  font-family: var(--font-mono);
  font-size: 8px;
  color: rgba(0,229,204,0.3);
  white-space: nowrap;
}

/* ─── SPONSOR SECTION ─── */
#sponsor {
  padding: 140px 0;
  background: var(--night);
}
.sponsor-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(0,150,136,0.07) 0%, transparent 70%);
}
.sponsor-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 64px;
}
.sponsor-header .eyebrow { justify-content: center; }
.sponsor-header .eyebrow::before { display: none; }
.sponsor-tiers {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 56px;
}
.tier-card {
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.1);
  border-radius: 14px;
  padding: 36px 32px;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}
.tier-card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(0,229,204,0.04), transparent 60%);
  pointer-events: none;
}
.tier-card.featured {
  border-color: rgba(0,229,204,0.3);
  box-shadow: 0 0 60px rgba(0,229,204,0.08), inset 0 0 40px rgba(0,229,204,0.04);
}
.tier-card:hover {
  transform: translateY(-6px);
  border-color: rgba(0,229,204,0.3);
  box-shadow: 0 24px 56px rgba(0,0,0,0.5), 0 0 40px rgba(0,229,204,0.1);
}
.tier-badge {
  position: absolute;
  top: 0; left: 50%;
  transform: translate(-50%, 0);
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 16px;
  background: var(--cyan);
  color: var(--night);
  border-radius: 0 0 8px 8px;
}
.tier-name {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.1em;
  color: var(--white-muted);
  margin-bottom: 12px;
  margin-top: 16px;
}
.tier-price {
  font-family: var(--font-display);
  font-size: 52px;
  line-height: 1;
  color: var(--cyan);
  margin-bottom: 8px;
}
.tier-card:nth-child(1) .tier-price { color: var(--white-soft); }
.tier-card:nth-child(3) .tier-price { color: var(--gold); }
.tier-range {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--white-muted);
  margin-bottom: 24px;
}
.tier-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: left;
}
.tier-features li {
  display: flex;
  gap: 10px;
  font-size: 13px;
  color: rgba(240,251,246,0.65);
  line-height: 1.5;
}
.tier-features li::before {
  content: '→';
  color: var(--cyan);
  font-family: var(--font-mono);
  font-size: 10px;
  flex-shrink: 0;
  margin-top: 2px;
}
.sponsor-value {
  background: var(--slate);
  border: 1px solid rgba(0,229,204,0.1);
  border-radius: 12px;
  padding: 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}
.sponsor-value-quote {
  font-size: 17px;
  font-style: italic;
  color: var(--white-soft);
  line-height: 1.75;
  border-left: 2px solid var(--cyan);
  padding-left: 24px;
}
.sponsor-why {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.why-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.why-icon {
  width: 32px; height: 32px;
  border-radius: 6px;
  background: rgba(0,229,204,0.1);
  border: 1px solid rgba(0,229,204,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
.why-text { font-size: 13px; color: var(--white-soft); line-height: 1.6; }

/* ─── FOUNDER ─── */
#founder {
  padding: 140px 0;
  background: var(--ink);
}
.founder-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.founder-visual {
  position: relative;
}
.founder-frame {
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.12);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.founder-frame::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0,229,204,0.06), transparent 60%, rgba(255,77,46,0.04));
}
.founder-initials {
  font-family: var(--font-display);
  font-size: 120px;
  color: rgba(0,229,204,0.12);
  letter-spacing: 0.05em;
  position: relative;
  z-index: 1;
}
.founder-corner {
  position: absolute;
  bottom: 24px; left: 24px;
  right: 24px;
  background: rgba(6,12,10,0.8);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0,229,204,0.14);
  border-radius: 10px;
  padding: 16px 20px;
}
.founder-name {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.08em;
  color: var(--white);
}
.founder-role {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-top: 3px;
}
.founder-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 10px;
}
.f-tag {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  padding: 3px 10px;
  border-radius: 20px;
  background: rgba(0,229,204,0.08);
  border: 1px solid rgba(0,229,204,0.18);
  color: var(--cyan);
}
.founder-content {}
.founder-pull {
  font-family: var(--font-display);
  font-size: clamp(28px, 3.5vw, 48px);
  line-height: 1.0;
  color: var(--white);
  margin-bottom: 24px;
}
.founder-pull .accent { color: var(--cyan); }
.founder-bio {
  font-size: 15px;
  color: var(--white-soft);
  line-height: 1.8;
  font-weight: 300;
  margin-bottom: 24px;
}
.founder-quote {
  border-left: 2px solid var(--ember);
  padding: 16px 22px;
  background: rgba(255,77,46,0.04);
  border-radius: 0 8px 8px 0;
  margin-bottom: 32px;
}
.founder-quote p {
  font-size: 15px;
  font-style: italic;
  color: var(--white-soft);
  line-height: 1.7;
}
.founder-quote cite {
  display: block;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  color: var(--white-muted);
  margin-top: 8px;
  font-style: normal;
}
.founder-creds {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.cred-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 13px;
  color: var(--white-muted);
}
.cred-item::before {
  content: '→';
  color: var(--cyan);
  font-family: var(--font-mono);
  font-size: 10px;
  flex-shrink: 0;
  margin-top: 2px;
}

/* ─── PRODUCTS ─── */
#products {
  padding: 140px 0;
  background: var(--night);
  border-top: 1px solid rgba(0,229,204,0.06);
}
.products-header { margin-bottom: 64px; }
.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.product-card {
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.09);
  border-radius: 12px;
  padding: 0;
  overflow: hidden;
  transition: all 0.3s;
}
.product-card:hover {
  border-color: rgba(0,229,204,0.22);
  transform: translateY(-3px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 24px rgba(0,229,204,0.06);
}
.product-visual {
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.pv-cyan { background: linear-gradient(135deg, #0D2420 0%, #1A3A34 100%); }
.pv-ember { background: linear-gradient(135deg, #1A1008 0%, #2A1A10 100%); }
.pv-volt { background: linear-gradient(135deg, #141A08 0%, #1E2A0A 100%); }
.pv-navy { background: linear-gradient(135deg, #080D12 0%, #0E1820 100%); }
.pv-coral { background: linear-gradient(135deg, #1A0808 0%, #2A100E 100%); }
.pv-dark { background: var(--slate); }
.product-icon {
  font-size: 56px;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 0 20px rgba(0,229,204,0.3));
}
.product-glow-dot {
  position: absolute;
  width: 120px; height: 120px;
  border-radius: 50%;
  background: rgba(0,229,204,0.08);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.product-info {
  padding: 22px 24px;
}
.product-tier {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--white-muted);
  margin-bottom: 6px;
}
.product-name {
  font-family: var(--font-display);
  font-size: 20px;
  letter-spacing: 0.04em;
  color: var(--white);
  margin-bottom: 6px;
}
.product-desc {
  font-size: 12px;
  color: var(--white-muted);
  line-height: 1.6;
}

/* ─── COMPETITIVE ─── */
#competitive {
  padding: 120px 0;
  background: var(--slate);
}
.comp-header { margin-bottom: 56px; }
.comp-table {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.comp-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  background: var(--dim);
  border: 1px solid rgba(255,255,255,0.04);
  border-radius: 8px;
  transition: all 0.25s;
}
.comp-row:hover { background: rgba(0,229,204,0.04); }
.comp-row.tr-row {
  background: rgba(0,229,204,0.06);
  border-color: rgba(0,229,204,0.25);
  box-shadow: 0 0 24px rgba(0,229,204,0.06);
}
.comp-who {
  font-weight: 600;
  font-size: 14px;
  min-width: 180px;
  color: var(--white);
}
.comp-row.tr-row .comp-who { color: var(--cyan); font-size: 16px; }
.comp-what {
  flex: 1;
  font-size: 12px;
  color: rgba(240,251,246,0.45);
}
.comp-gap {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ember);
  min-width: 200px;
  text-align: right;
}
.comp-row.tr-row .comp-gap { color: var(--cyan); font-weight: 700; }

/* ─── QUOTE TICKER ─── */
#ticker {
  padding: 80px 0;
  background: var(--ink);
  overflow: hidden;
}
.ticker-track {
  display: flex;
  animation: ticker-scroll 32s linear infinite;
  width: max-content;
  gap: 0;
}
@keyframes ticker-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.ticker-item {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 0 40px;
  white-space: nowrap;
}
.ticker-text {
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.05em;
  color: var(--white-muted);
}
.ticker-text span { color: var(--cyan); }
.ticker-sep {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--ember);
  flex-shrink: 0;
}

/* ─── CTA SECTION ─── */
#cta {
  padding: 140px 0;
  background: var(--night);
  position: relative;
}
.cta-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 70% at 50% 50%, rgba(0,229,204,0.06) 0%, transparent 70%);
}
.cta-content {
  text-align: center;
  max-width: 780px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}
.cta-pre {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.25em;
  color: var(--ember);
  margin-bottom: 12px;
  animation: blink-text 1.8s step-end infinite;
}
.cta-title {
  font-family: var(--font-display);
  font-size: clamp(56px, 9vw, 110px);
  line-height: 0.88;
  color: var(--white);
  margin-bottom: 16px;
  letter-spacing: 0.02em;
}
.cta-title .accent { color: var(--cyan); }
.cta-sub {
  font-size: 16px;
  color: var(--white-soft);
  max-width: 540px;
  margin: 0 auto 48px;
  line-height: 1.75;
  font-weight: 300;
}
.cta-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 560px;
  margin: 0 auto 32px;
}
.cta-row { display: flex; gap: 14px; }
.cta-input {
  flex: 1;
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.15);
  border-radius: 6px;
  padding: 14px 18px;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 14px;
  outline: none;
  transition: all 0.25s;
}
.cta-input::placeholder { color: var(--white-muted); }
.cta-input:focus {
  border-color: rgba(0,229,204,0.45);
  background: rgba(0,229,204,0.04);
  box-shadow: 0 0 0 3px rgba(0,229,204,0.08);
}
.cta-select {
  flex: 1;
  background: var(--dim);
  border: 1px solid rgba(0,229,204,0.15);
  border-radius: 6px;
  padding: 14px 18px;
  color: var(--white-soft);
  font-family: var(--font-body);
  font-size: 14px;
  outline: none;
  appearance: none;
  cursor: pointer;
  transition: all 0.25s;
}
.cta-select:focus {
  border-color: rgba(0,229,204,0.45);
}
.cta-select option { background: var(--dim); color: var(--white); }
.cta-btn {
  background: var(--cyan);
  color: var(--night);
  border: none;
  border-radius: 6px;
  padding: 16px 20px;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.25s;
  font-weight: 700;
  width: 100%;
}
.cta-btn:hover {
  background: var(--volt);
  box-shadow: 0 0 36px var(--volt-glow), 0 8px 24px rgba(0,0,0,0.3);
  transform: translateY(-2px);
}
.cta-note {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--white-muted);
  letter-spacing: 0.08em;
}
.cta-options {
  display: flex;
  gap: 28px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 48px;
}
.cta-option-item {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--white-muted);
  display: flex;
  align-items: center;
  gap: 8px;
  text-transform: uppercase;
}
.cta-option-item .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--cyan); }

/* ─── FOOTER ─── */
footer {
  background: var(--ink);
  border-top: 1px solid rgba(0,229,204,0.1);
  padding: 80px 0 40px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 60px;
  margin-bottom: 60px;
}
.footer-brand {}
.footer-logo {
  font-family: var(--font-display);
  font-size: 28px;
  letter-spacing: 0.1em;
  color: var(--white);
  margin-bottom: 12px;
  display: block;
}
.footer-tagline {
  font-family: var(--font-display);
  font-size: 14px;
  letter-spacing: 0.2em;
  color: var(--cyan);
  margin-bottom: 16px;
}
.footer-desc {
  font-size: 13px;
  color: var(--white-muted);
  line-height: 1.7;
  max-width: 280px;
}
.footer-dispatch {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  color: var(--ember);
  margin-top: 16px;
  animation: blink-text 1.4s step-end infinite;
}
.footer-col-title {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--white-muted);
  margin-bottom: 18px;
}
.footer-col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-col ul a {
  font-size: 13px;
  color: rgba(240,251,246,0.5);
  text-decoration: none;
  transition: color 0.2s;
}
.footer-col ul a:hover { color: var(--cyan); }
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28px;
  border-top: 1px solid rgba(0,229,204,0.06);
  flex-wrap: wrap;
  gap: 12px;
}
.footer-legal {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  color: rgba(240,251,246,0.2);
}
.footer-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  color: rgba(0,229,204,0.4);
}
.status-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--cyan);
  animation: pulse-dot 2s infinite;
}

/* ─── REVEAL ANIMATIONS ─── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal.visible {
  opacity: 1;
  transform: none;
}
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }
.reveal-delay-5 { transition-delay: 0.5s; }

/* ─── GLOW LINE ANIMATION ─── */
@keyframes glow-line {
  0%, 100% { box-shadow: 0 0 10px rgba(0,229,204,0.2); }
  50% { box-shadow: 0 0 30px rgba(0,229,204,0.5); }
}

/* ─── CURSOR GLOW ─── */
.cursor-glow {
  position: fixed;
  width: 320px; height: 320px;
  border-radius: 50%;
  pointer-events: none;
